{
  "name": "@mattstrom/resume-builder",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "workspaces": [
    "packages/backend",
    "packages/crdt",
    "packages/entities",
    "packages/ontologies",
    "packages/orchestration",
    "packages/resume-builder"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prestart": "docker compose up -d --wait redis db",
    "start": "nx run-many -t dev -p @resume-builder/entities @resume-builder/backend @resume-builder/crdt @resume-builder/web orchestration --parallel=10",
    "start:mcp": "op run --env-file=.env -- sh -c 'docker compose up -d mcp'",
    "build": "tsc && vite build",
    "test": "nx run-many -t test",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docker:build": "nx run-many -t docker-build",
    "docker:push": "nx run-many -t docker-push",
    "deploy": "op run --env-file=.env -- sh -c 'helm upgrade ${RELEASE:-resume-builder} charts/resume-builder --namespace ${NAMESPACE:-resume-builder} --set backend.image.tag=${TAG:-latest} --set web.image.tag=${TAG:-latest} --set orchestration.image.tag=${TAG:-latest} --set crdt.image.tag=${TAG:-latest} --set postgres.password=${POSTGRES_PROD_PASSWORD} --set orchestration.anthropicApiKey=${ANTHROPIC_API_KEY} --set orchestration.auth0.clientId=${AUTH_CLIENT_ID} --install'"
  },
  "dependencies": {
    "lightningcss": "^1.30.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nx/js": "22.6.4",
    "@nx/storybook": "22.6.4",
    "@nx/vite": "22.6.4",
    "@nx/vitest": "22.6.4",
    "@nx/web": "22.6.4",
    "@storybook/addon-docs": "^10.3.4",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/html2canvas": "^0.5.35",
    "@types/trusted-types": "^2.0.7",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.0",
    "commander": "^14.0.2",
    "del-cli": "^7.0.0",
    "jiti": "2.4.2",
    "nx": "22.6.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "playwright": "^1.59.1",
    "storybook": "10.5.8",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "vite": "^5.2.0",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "zod": "^4.3.6"
  }
}
