{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ],
      "options": {
        "command": "npm run start:direct",
        "cwd": "packages/crdt"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run start:direct",
        "cwd": "packages/crdt"
      },
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ]
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f packages/crdt/Dockerfile -t ${REGISTRY:-registry.mattstrom.com}/resume-builder-crdt:${TAG:-latest} ."
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker push ${REGISTRY:-registry.mattstrom.com}/resume-builder-crdt:${TAG:-latest}"
      }
    }
  }
}
