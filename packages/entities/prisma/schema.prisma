generator client {
  provider        = "prisma-client"
  output          = "../../backend/src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

generator crdtClient {
  provider        = "prisma-client"
  output          = "../../crdt/src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

generator zod {
  provider                 = "zod-prisma-types"
  output                   = "../src/generated/zod"
  useMultipleFiles         = true
  writeBarrelFiles         = true
  createInputTypes         = false
  createModelTypes         = true
  createPartialTypes       = false
  addInputTypeValidation   = false
  addIncludeType           = false
  addSelectType            = false
  writeNullishInModelTypes = true
  coerceDate               = false
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Profile ────────────────────────────────────────────────────────────────
// uid maps to Auth0 sub, unique per user.
// narrativeSummary and jobPreferences are JSON blobs — not yet normalized.

model Profile {
  id               String   @id @default(cuid())
  uid              String   @unique
  narrative        String   @default("")
  narrativeSummary Json?
  jobPreferences   Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([uid])
}

// ─── Conversation ────────────────────────────────────────────────────────────
// applicationId is a plain String — no FK until Application is migrated.
// model stores ChatModelSelection shape: { provider, model }

model Conversation {
  id            String                @id @default(cuid())
  uid           String
  applicationId String?
  title         String                @default("New Conversation")
  messages      ConversationMessage[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([uid])
  @@index([applicationId])
}

// ─── ConversationMessage ─────────────────────────────────────────────────────
model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── Fact ────────────────────────────────────────────────────────────────────
// A durable, reusable career fact owned by a user.
// embedding is intentionally Unsupported — reads/writes go through $queryRaw/$executeRaw.

model Fact {
  id                String                      @id @default(cuid())
  uid               String
  /// @zod.string.describe("One or two sentence description of the fact")
  what              String
  /// @zod.string.describe("Measurable outcome or impact (e.g. 'reduced latency by 40%')")
  impact            String?
  /// @zod.string.describe("Scale or magnitude (e.g. 'team of 8', '$2M ARR product')")
  scale             String?
  /// @zod.string.describe("Key phrase from the narrative node this fact was extracted from")
  citation          String?
  /// @zod.number.int().describe("CRDT node index in the narrative document at the time of extraction")
  citationNodeIndex Int?
  embedding         Unsupported("vector(768)")?
  embeddingRevision Int                         @default(1)
  embeddedRevision  Int?
  embeddingModel    String?
  embeddingProfile  String?
  createdAt         DateTime                    @default(now())

  expressions Expression[]
  resumeFacts ResumeFact[]
  concepts    FactConcept[]

  @@index([uid])
}

// ─── Expression ──────────────────────────────────────────────────────────────
// Normalized semantic nodes and edges. Vocabulary/key correspond to stable IDs
// in @resume-builder/ontologies; labels remain presentation data.

model Concept {
  id                String                      @id @default(cuid())
  vocabulary        String
  key               String
  label             String
  definition        String?
  externalUri       String?
  embedding         Unsupported("vector(768)")?
  embeddingRevision Int                         @default(1)
  embeddedRevision  Int?
  embeddingModel    String?
  embeddingProfile  String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  aliases           ConceptAlias[]
  facts             FactConcept[]
  bullets           BulletConcept[]
  jobRequirements   JobRequirementConcept[]
  outgoingRelations ConceptRelation[]       @relation("ConceptRelationSource")
  incomingRelations ConceptRelation[]       @relation("ConceptRelationTarget")

  @@unique([vocabulary, key])
  @@index([vocabulary, label])
}

model ConceptAlias {
  id              String   @id @default(cuid())
  conceptId       String
  label           String
  normalizedLabel String
  createdAt       DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, normalizedLabel])
  @@index([normalizedLabel])
}

model FactConcept {
  factId     String
  conceptId  String
  relation   String
  source     String   @default("user")
  confidence Float?
  qualifier  Json?
  createdAt  DateTime @default(now())

  fact    Fact    @relation(fields: [factId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([factId, conceptId, relation])
  @@index([conceptId, relation])
}

model ConceptRelation {
  sourceConceptId String
  targetConceptId String
  relation        String
  source          String   @default("ontology")
  confidence      Float?
  createdAt       DateTime @default(now())

  sourceConcept Concept @relation("ConceptRelationSource", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  targetConcept Concept @relation("ConceptRelationTarget", fields: [targetConceptId], references: [id], onDelete: Cascade)

  @@id([sourceConceptId, targetConceptId, relation])
  @@index([targetConceptId, relation])
}

// A rendered prose variant of a Fact. One fact can have many expressions that
// differ in length or tone.
model Expression {
  id        String   @id @default(cuid())
  factId    String
  /// @zod.string.describe("The polished prose expression suitable for a resume bullet")
  text      String
  /// @zod.string.describe("Length category (e.g. 'short', 'medium', 'long')")
  length    String?
  /// @zod.string.describe("Tone (e.g. 'formal', 'concise', 'confident')")
  tone      String?
  createdAt DateTime @default(now())

  fact        Fact         @relation(fields: [factId], references: [id], onDelete: Cascade)
  resumeFacts ResumeFact[]

  @@index([factId])
}

// ─── JobRequirementFact ───────────────────────────────────────────────────────
// A structured requirement extracted from a job description.
// applicationId references a MongoDB-resident Application — plain String, no FK.
// embedding is intentionally Unsupported — reads/writes go through $queryRaw/$executeRaw.

model JobRequirementFact {
  id                String                      @id @default(cuid())
  uid               String
  applicationId     String
  /// @zod.string.describe("Requirement kind: 'required', 'preferred', 'responsibility', or 'culture'")
  kind              String
  /// @zod.string.describe("One-sentence description of the requirement")
  what              String
  technologies      String[]
  tags              String[]
  embedding         Unsupported("vector(768)")?
  embeddingRevision Int                         @default(1)
  embeddedRevision  Int?
  embeddingModel    String?
  embeddingProfile  String?
  createdAt         DateTime                    @default(now())

  concepts JobRequirementConcept[]

  @@index([uid])
  @@index([applicationId])
}

// A job-side semantic assertion pointing into the shared concept graph.
// Quantitative constraints stay on the assertion rather than becoming concepts.
model JobRequirementConcept {
  jobRequirementId String
  conceptId        String
  /// @zod.string.describe("Job-side predicate: 'requires', 'prefers', or 'expects'")
  relation         String
  source           String   @default("classifier")
  confidence       Float?
  qualifier        Json?
  createdAt        DateTime @default(now())

  jobRequirement JobRequirementFact @relation(fields: [jobRequirementId], references: [id], onDelete: Cascade)
  concept        Concept            @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([jobRequirementId, conceptId, relation])
  @@index([conceptId, relation])
}

// ─── Resume ──────────────────────────────────────────────────────────────────
// data is retained temporarily as the source for the offline XML cutover.
// ResumeXml is authoritative after a resume has been migrated.
// applicationId and sourceResumeId are plain strings during dual-DB transition.

model Resume {
  id             String   @id @default(cuid())
  uid            String
  name           String   @default("")
  company        String   @default("")
  level          String?
  jobPostingUrl  String   @default("")
  readOnly       Boolean  @default(false)
  base           Boolean  @default(false)
  applicationId  String?
  sourceResumeId String?
  data           Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sourceResume               Resume?                     @relation("ResumeVersions", fields: [sourceResumeId], references: [id])
  derivedResumes             Resume[]                    @relation("ResumeVersions")
  resumeXml                  ResumeXml?
  conceptEvidenceAssessments ConceptEvidenceAssessment[]

  @@index([uid])
  @@index([applicationId])
  @@index([sourceResumeId])
}

// Native PostgreSQL XML is intentionally isolated in a sidecar model because
// Prisma Client cannot expose Unsupported("xml") fields through generated CRUD.
// Read and write it through the ResumeXmlRepository using parameterized raw SQL.
model ResumeXml {
  resumeId      String             @id
  content       Unsupported("xml")
  schemaVersion Int                @default(1)
  updatedAt     DateTime           @updatedAt
  resume        Resume             @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

// ─── Application ─────────────────────────────────────────────────────────────
// jobSummary and analysis are JSON blobs — see PgApplication in @resume-builder/entities.
// coverLetterId is a plain string during dual-DB transition.

model Application {
  id             String   @id @default(cuid())
  uid            String
  companyId      String?
  name           String   @default("")
  company        String   @default("")
  jobPostingUrl  String   @default("")
  jobDescription String?
  notionId       String?
  coverLetterId  String?
  jobSummary     Json?
  analysis       Json?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyRecord              Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  conceptEvidenceAssessments ConceptEvidenceAssessment[]

  @@index([uid])
  @@index([companyId])
}

// Latest persisted concept-to-resume evidence assessment for an application
// resume. inputHash makes staleness explicit when either source changes.
model ConceptEvidenceAssessment {
  id               String   @id @default(cuid())
  uid              String
  applicationId    String
  resumeId         String
  inputHash        String
  evaluatorVersion Int
  result           Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resume      Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([uid, applicationId, resumeId])
  @@index([applicationId])
  @@index([resumeId])
}

// ─── Company ────────────────────────────────────────────────────────────────

enum CompanyType {
  employer
  recruiter
  other
}

enum LocationType {
  on_site
  hybrid
  remote
}

model Company {
  id           String       @id @default(cuid())
  name         String       @default("")
  type         CompanyType  @default(employer)
  website      String       @default("")
  logoUrl      String       @default("")
  locationType LocationType @default(remote)
  address      Json         @default("{}")
  createdAt    DateTime     @default(now())
  createdBy    String
  updatedAt    DateTime     @updatedAt
  updatedBy    String

  applications Application[]

  @@index([createdBy])
  @@index([name])
}

// ─── CoverLetter ─────────────────────────────────────────────────────────────

model CoverLetter {
  id            String   @id @default(cuid())
  uid           String
  name          String   @default("")
  company       String   @default("")
  jobPostingUrl String   @default("")
  content       String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([uid])
}

// ─── ContactInformation ──────────────────────────────────────────────────────

model ContactInformation {
  id              String   @id @default(cuid())
  uid             String   @unique
  location        String   @default("")
  phoneNumber     String   @default("")
  email           String   @default("")
  linkedInProfile String   @default("")
  githubProfile   String   @default("")
  personalWebsite String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([uid])
}

// ─── ProjectType ─────────────────────────────────────────────────────────────

enum ProjectType {
  professional
  personal
}

// ─── Job ─────────────────────────────────────────────────────────────────────

model Job {
  id               String   @id @default(cuid())
  uid              String
  company          String   @default("")
  position         String   @default("")
  location         String   @default("")
  startDate        String   @default("")
  endDate          String?
  responsibilities String[]
  relevance        Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([uid])
}

// ─── Education ───────────────────────────────────────────────────────────────

model Education {
  id          String   @id @default(cuid())
  uid         String
  degree      String   @default("")
  field       String   @default("")
  institution String   @default("")
  graduated   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uid])
}

// ─── Project ─────────────────────────────────────────────────────────────────

model Project {
  id           String       @id @default(cuid())
  uid          String
  name         String       @default("")
  description  String       @default("")
  technologies String[]
  items        String[]
  type         ProjectType?
  relevance    Float?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([uid])
}

// ─── Skill ───────────────────────────────────────────────────────────────────

model Skill {
  id        String   @id @default(cuid())
  uid       String
  name      String   @default("")
  category  String   @default("")
  relevance Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uid])
}

// ─── SkillGroup ──────────────────────────────────────────────────────────────

model SkillGroup {
  id        String   @id @default(cuid())
  uid       String
  name      String   @default("")
  items     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uid])
}

// ─── Volunteering ────────────────────────────────────────────────────────────

model Volunteering {
  id               String   @id @default(cuid())
  uid              String
  organization     String?
  position         String   @default("")
  location         String?
  startDate        String   @default("")
  endDate          String?
  responsibilities String[]
  relevance        Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([uid])
}

// ─── Bullet ─────────────────────────────────────────────────────────────────

enum BulletSourceType {
  job
  project
  volunteering
}

enum BulletStatus {
  draft
  ready
  archived
}

model Bullet {
  id                          String                      @id @default(cuid())
  uid                         String
  text                        String
  sourceType                  BulletSourceType
  sourceId                    String
  status                      BulletStatus                @default(draft)
  position                    Int                         @default(0)
  contextScore                Float?
  contextNote                 String?
  contextWhatWorksWell        String[]                    @default([])
  contextWhyItMatters         String?
  contextProposedEnhancements String[]                    @default([])
  actionScore                 Float?
  actionNote                  String?
  actionWhatWorksWell         String[]                    @default([])
  actionWhyItMatters          String?
  actionProposedEnhancements  String[]                    @default([])
  outcomeScore                Float?
  outcomeNote                 String?
  outcomeWhatWorksWell        String[]                    @default([])
  outcomeWhyItMatters         String?
  outcomeProposedEnhancements String[]                    @default([])
  clarityScore                Float?
  clarityNote                 String?
  clarityWhatWorksWell        String[]                    @default([])
  clarityWhyItMatters         String?
  clarityProposedEnhancements String[]                    @default([])
  embedding                   Unsupported("vector(768)")?
  embeddingRevision           Int                         @default(1)
  embeddedRevision            Int?
  embeddingModel              String?
  embeddingProfile            String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  concepts BulletConcept[]

  @@index([uid, status])
  @@index([uid, sourceType, sourceId])
  @@index([uid, sourceType, sourceId, position])
}

model BulletConcept {
  bulletId   String
  conceptId  String
  relation   String
  source     String   @default("user")
  confidence Float?
  qualifier  Json?
  createdAt  DateTime @default(now())

  bullet  Bullet  @relation(fields: [bulletId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([bulletId, conceptId, relation])
  @@index([conceptId, relation])
}

// ─── ResumeFact ───────────────────────────────────────────────────────────────
// Links a Fact (and optionally a specific Expression) to a Resume.
// resumeId references a MongoDB-resident Resume — plain String, no FK.

model ResumeFact {
  resumeId     String
  factId       String
  expressionId String?
  section      String?
  position     Int?

  fact       Fact        @relation(fields: [factId], references: [id], onDelete: Cascade)
  expression Expression? @relation(fields: [expressionId], references: [id])

  @@id([resumeId, factId])
  @@index([resumeId])
}

// ─── DocumentUpdate ──────────────────────────────────────────────────────────
// Append-only log of Yjs CRDT binary state snapshots for collaborative documents.
// Each row is immutable — never updated, only inserted. The highest sequence
// for a given (name, uid) is the current state.

model DocumentUpdate {
  id        String   @id @default(cuid())
  name      String
  uid       String
  sequence  Int
  update    Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name, uid, sequence(sort: Desc)])
}
