{
  "name": "@resume-builder/backend",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "build": "npm -w @resume-builder/entities run prisma:generate && nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "inspect": "npx --no-cache @modelcontextprotocol/inspector",
    "script:backfill-embeddings": "nest start --entryFile scripts/backfill-embeddings"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@bull-board/nestjs": "^7.0.0",
    "@hocuspocus/provider": "^3.4.4",
    "@mastra/fastembed": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@nestjs-mcp/server": "^1.0.0",
    "@nestjs/apollo": "^13.2.4",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.17",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@resume-builder/entities": "file:../entities",
    "@resume-builder/ontologies": "file:../ontologies",
    "ai": "^6.0.94",
    "app-root-path": "^3.1.0",
    "bullmq": "^5.74.0",
    "config": "^4.1.1",
    "controller": "^1.0.0",
    "convict": "^6.2.4",
    "graphql": "^16.12.0",
    "graphql-type-json": "^0.3.2",
    "ioredis": "^5.10.1",
    "jwks-rsa": "^4.0.1",
    "mongoose": "^9.0.2",
    "ollama": "^0.6.3",
    "outdent": "^0.8.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "puppeteer": "^24.37.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "service": "^0.1.4",
    "ts-node": "^10.9.2",
    "winston": "^3.19.0",
    "ws": "^8.19.0",
    "yjs": "^13.6.30",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/config": "^3.3.5",
    "@types/convict": "^6.1.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@typegoose/typegoose": {
      "mongoose": "$mongoose"
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@resume-builder/ontologies$": "<rootDir>/../../ontologies/src/index.ts"
    },
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "Node",
            "resolvePackageJsonExports": false,
            "verbatimModuleSyntax": false
          }
        }
      ]
    }
  }
}
