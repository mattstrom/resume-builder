{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "npm run dev",
        "cwd": "{projectRoot}"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker buildx build --load -f packages/orchestration/Dockerfile -t ${REGISTRY:-registry.mattstrom.com}/resume-builder-orchestration:${TAG:-latest} ."
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker push ${REGISTRY:-registry.mattstrom.com}/resume-builder-orchestration:${TAG:-latest}"
      }
    }
  }
}
